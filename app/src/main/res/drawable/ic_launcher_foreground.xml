<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Approximate reconstruction of the "A" Logo using Vector Paths -->
    <path
        android:pathData="M30,75 L54,30 L78,75"
        android:strokeWidth="12"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="30"
                android:startY="75"
                android:endX="78"
                android:endY="75"
                android:type="linear">
                <item android:offset="0.0" android:color="#33B5E5" /> <!-- Cyan -->
                <item android:offset="0.5" android:color="#7E57C2" /> <!-- Purple -->
                <item android:offset="1.0" android:color="#EC407A" /> <!-- Pink -->
            </gradient>
        </aapt:attr>
    </path>

    <path
        android:pathData="M44,55 L64,55"
        android:strokeWidth="8"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="44"
                android:startY="55"
                android:endX="64"
                android:endY="55"
                android:type="linear">
                <item android:offset="0.0" android:color="#5CB8E6" />
                <item android:offset="1.0" android:color="#9C66D8" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
